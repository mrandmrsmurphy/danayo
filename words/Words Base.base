filters:
  and:
    - file.inFolder("words")
    - file.ext == "md"
views:
  - type: table
    name: Table
    order:
      - file.name
      - 羅馬字
      - 注音
      - date-last-perfect
      - lexipedia
      - english
      - pos
      - 諺文
      - file.mtime
    sort:
      - property: lexipedia
        direction: ASC
      - property: file.mtime
        direction: DESC
      - property: date-last-perfect
        direction: ASC
      - property: pos
        direction: ASC
      - property: 羅馬字
        direction: ASC
      - property: 注音
        direction: DESC
      - property: english
        direction: ASC
      - property: 諺文
        direction: ASC
      - property: 品詞
        direction: ASC
      - property: japanese
        direction: ASC
      - property: file.name
        direction: ASC
      - property: characters
        direction: ASC
    columnSize:
      file.name: 62
      note.羅馬字: 71
      note.注音: 131
      note.lexipedia: 126
      note.english: 202
