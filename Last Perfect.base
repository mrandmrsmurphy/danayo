views:
  - type: table
    name: Table
    order:
      - file.name
      - 注音
      - 羅馬字
      - 諺文
      - date-last-perfect
      - english
      - file.mtime
      - file.folder
      - file.ctime
      - file.size
    sort:
      - property: date-last-perfect
        direction: DESC
      - property: file.size
        direction: ASC
      - property: file.mtime
        direction: DESC
      - property: joyo_level
        direction: DESC
      - property: file.name
        direction: ASC
      - property: size
        direction: DESC
      - property: 羅馬字
        direction: ASC
      - property: 諺文
        direction: ASC
      - property: 注音
        direction: ASC
      - property: alias
        direction: ASC
    columnSize:
      file.name: 136
      note.注音: 97
      note.羅馬字: 106
      note.諺文: 62
      note.english: 188
      file.mtime: 201
      file.size: 126
